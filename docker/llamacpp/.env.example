# Required: GGUF file name (or path under the mount), NOT a host path like ./models/...
# Host directory is LLAMA_MODELS_DIR; inside the container it is always /models.
# Examples (pick one):
#   GGUF_FILE=llama-2-7b-chat.Q4_K_M.gguf
#   GGUF_FILE=llama-2-7b-chat.f16.gguf
#   GGUF_FILE=mistral-7b-instruct-v0.2.Q4_K_M.gguf
#   GGUF_FILE=mistral-7b-instruct-v0.2.f16.gguf
#   GGUF_FILE=saiga-7b.Q4_K_M.gguf
#   GGUF_FILE=saiga-7b.f16.gguf
GGUF_FILE=llama-2-7b-chat.Q4_K_M.gguf

LLAMA_MODELS_DIR=./models
HOST_PORT=8080
# llama-server -c (RAM↑); must match scripts/extract_legal_entities_llm.py --server-context
N_CTX=8192

# llama-server -np: parallel slots for concurrent HTTP clients (continuous batching is default on).
# Use ≥ scripts/extract_legal_entities_llm.py --batch-size (parallel row workers). Use -1 for auto.
N_PARALLEL=4

# --- CPU (default)
#LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server
#N_GPU_LAYERS=0

# --- NVIDIA GPU ---
# LLAMA_SERVER_IMAGE=ghcr.io/ggml-org/llama.cpp:server-cuda
N_GPU_LAYERS=-1
