VLLM_BASE_URL=http://127.0.0.1:8000/v1

OPENAI_API_KEY=EMPTY

VLLM_MODEL=vikhr-lora

# Память GPU для docker compose / serve-vllm (доля от полного объёма карты).
# При «Free memory ... less than desired GPU memory utilization» на старте — уменьшайте (0.72–0.75).
# При CUDA OOM при выделении KV после загрузки весов — уменьшите VLLM_MAX_MODEL_LEN (384/256) или
# подстройте utilization (как в вашем рабочем профиле часто 0.75).
 VLLM_GPU_MEMORY_UTILIZATION=0.68
 VLLM_MAX_MODEL_LEN=512
 VLLM_MAX_NUM_SEQS=1
# VLLM_MAX_NUM_BATCHED_TOKENS=1024
 VLLM_BLOCK_SIZE=16
# В контейнере vLLM: PYTORCH_ALLOC_CONF=expandable_segments:True
 VLLM_PORT=8000
# Таймаут HTTP к vLLM (сек), первый ответ на GPU может быть долгим
VLLM_REQUEST_TIMEOUT=120
VLLM_MAX_TOKENS=256

# Парсер tool calls для vLLM (create_agent шлёт tool_choice=auto). См. https://docs.vllm.ai/en/latest/features/tool_calling.html
VLLM_TOOL_CALL_PARSER=hermes


#VLLM_FORCE_TOOL_FIRST=1
#AGENT_DEBUG_TOOL_STAGE=1 
#AGENT_DEBUG_STAGE_2=1 