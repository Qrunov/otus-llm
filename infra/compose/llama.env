# Copy to .env next to compose.yaml (or export before `docker compose up`).
# Default stack: AWQ 4-bit 7B — realistic for ~8 GiB VRAM.

# Served model id (must match astrag configs/default.yaml `model` and OPENAI_MODEL)
VLLM_MODEL=solidrust/Llama-3-8B-Instruct-Coder-AWQ
# vLLM quantization: awq_marlin when supported (faster); use awq if Marlin fails on your GPU
VLLM_QUANTIZATION=awq_marlin

VLLM_PORT=8000
# Lower if startup fails: free_VRAM must exceed util × total_VRAM (e.g. 0.78 × 7.66 GiB ≈ 5.97 GiB reserved)
VLLM_GPU_MEMORY_UTILIZATION=0.83
# Raise on larger GPUs; ~8 GiB + this model: keep ≤3072 or increase VLLM_GPU_MEMORY_UTILIZATION
VLLM_MAX_MODEL_LEN=3072
HF_TOKEN=

# Default compose adds --enforce-eager (no torch.compile) for ~8 GiB VRAM. For faster inference on large GPUs, use a compose override without that flag.

# PyTorch allocator (helps fragmentation; vLLM suggests when OOM)
PYTORCH_ALLOC_CONF=expandable_segments:True

# Optional: absolute path to HF cache on host (compose default uses $HOME from your shell)
# HF_CACHE_HOST=/home/you/.cache/huggingface
