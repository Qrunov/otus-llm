# Langfuse UI (after docker compose up). Prefer BASE_URL (SDK reads both; HOST is legacy).
LANGFUSE_BASE_URL=http://localhost:3000
# LANGFUSE_HOST=http://localhost:3000

# Project API keys: Settings → API Keys (pk-lf-… / sk-lf-…). Same deployment as BASE_URL.
# Order matters for Basic auth: public first, secret second — do not swap.
# Avoid trailing spaces when exporting to the shell.
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...

# astrag bench sends traces when langfuse_enabled: true in YAML (not dry-run).
# OTLP export uses POST …/api/public/otel/v1/traces with Basic(pk, sk). If you see 401 in logs:
#   uv run astrag langfuse-check
